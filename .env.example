# Postgres connection string (Neon, Supabase, Render Postgres). sqlite:///./retail.db for a quick local run.
DATABASE_URL="postgresql://user:password@host:5432/retail?sslmode=require"

# Signs the session cookie. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET="change-me"

# The single login. On startup this account is created, or its password is replaced.
INITIAL_EMAIL="you@example.com"
INITIAL_PASSWORD="change-me-please"

# Store defaults, editable in Settings afterwards
BUSINESS_NAME="My Store"
CURRENCY_CODE="NGN"
CURRENCY_LOCALE="en-NG"
TAX_ENABLED="false"

# Set to true when the site is served over HTTPS (Render, Fly, any host with TLS)
COOKIE_SECURE="false"
