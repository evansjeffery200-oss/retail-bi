# Postgres connection string (Neon, Supabase, Render Postgres, etc.)
DATABASE_URL="postgresql://user:password@host:5432/retail?sslmode=require"

# Long random string used to sign session cookies
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Credentials for the first login created by `npm run db:seed`
INITIAL_EMAIL="you@example.com"
INITIAL_PASSWORD="change-me-please"

# Store identity defaults
BUSINESS_NAME="My Store"
CURRENCY_CODE="NGN"
CURRENCY_LOCALE="en-NG"
